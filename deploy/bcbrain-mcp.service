[Unit]
Description=BC Brain Fast MCP & REST Sidecar (brain.bcsmethai.com/mcp, port 3961)
After=network.target

[Service]
Type=simple
Environment=PORT=3961
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production
WorkingDirectory=/opt/bcbrain
ExecStart=/usr/bin/node scripts/mcp-server.ts
Restart=always
RestartSec=2
# least privilege: throwaway user, read-only system, no privilege escalation
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
