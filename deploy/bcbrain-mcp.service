[Unit]
Description=BC Brain Compiled Go MCP & REST Sidecar (brain.bcsmethai.com/mcp, port 3961)
After=network.target

[Service]
Type=simple
Environment=PORT=3961
Environment=HOSTNAME=127.0.0.1
Environment=BC_GO_PACK_FILE=/opt/bcbrain/public/go-brain-pack.json
WorkingDirectory=/opt/bcbrain
ExecStart=/opt/bcbrain/bcbrain-mcp
Restart=always
RestartSec=2
# resource bounds (~20 MB typical RSS for compiled Go sidecar)
MemoryHigh=96M
MemoryMax=160M
# least privilege: throwaway user, read-only system, strict kernel/fs hardening
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
